<form class="ui stacked segment form" action="/playlist/{{id}}/addsong" method="POST">
  <div class="two fields">
    <div class="field">
      <label>Title</label>
      <input type="text" name="title" title = "Please include a valid Title"
	  placeholder="Title"> <!-- autofocus attribute focuses the input field when the page loads -->
    </div>
    <div class="field">
      <label>Artist</label>
      <input type="text" name="artist" title = "Please include a valid Artist"
	  placeholder="Artist"> <!-- required attribute ensures the field must be filled out before submitting -->
    </div>
  </div>
  <button class="ui blue submit button">Add Song</button>
</form>


<!-- Autofocus and required titles in the 2 input forms were removed but commented anyway for future reference. -->
